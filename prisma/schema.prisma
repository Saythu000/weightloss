generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("AGENT")
  password  String
  createdAt DateTime @default(now())
}

model Lead {
  id                  String   @id @default(uuid())
  phoneNumber         String   @unique
  name                String?
  age                 Int?
  bmi                 Float?
  healthFlags         Json?
  preferredMedication String?
  intakeStatus        String   @default("IN_PROGRESS")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  appointmentSlot     String?
  category            String   @default("CUSTOMER")
  partnershipDetails  Json?
  paymentStatus       String   @default("UNPAID")
  recruitmentDetails  Json?
}

model ConnectedAccount {
  id                String    @id @default(uuid())
  platform          String
  accountName       String?
  externalAccountId String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  status            String?   @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MediaAsset {
  id        String      @id @default(uuid())
  fileUrl   String
  fileSize  BigInt
  createdAt DateTime    @default(now())
  filename  String
  mimeType  String
  PostDraft PostDraft[]
}

model PostDraft {
  id             String       @id @default(uuid())
  title          String
  masterCaption  String
  mediaAssetId   String?
  createdAt      DateTime     @default(now())
  budget         Float?
  targetAudience String?
  type           String       @default("ORGANIC")
  mediaAsset     MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  PostTarget     PostTarget[]
  PublishJob     PublishJob[]
}

model PostTarget {
  id            String    @id @default(uuid())
  platform      String
  status        String    @default("READY")
  customCaption String?
  draftId       String
  draft         PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model PublishJob {
  id           String    @id @default(uuid())
  jobStatus    String    @default("PENDING")
  attempts     Int       @default(0)
  externalUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  draftId      String
  errorMessage String?
  platform     String
  draft        PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model WhatsappOrder {
  id              String   @id @default(uuid())
  userId          String
  productName     String
  price           Decimal
  shippingAddress String
  paymentMethod   String
  status          String   @default("PENDING_COD")
  createdAt       DateTime @default(now())
  metadata        Json?
}

model Intake {
  id             String    @id @default(uuid())
  userId         String
  firstName      String
  lastName       String
  email          String
  phone          String
  shippingState  String?
  height         Float?
  weight         Float?
  goalWeight     Float?
  gender         String?
  dateOfBirth    DateTime?
  healthData     Json?
  history        Json?
  preferences    Json?
  additionalInfo String?
  createdAt      DateTime  @default(now())
}

model Eligibility {
  id        String   @id @default(uuid())
  userId    String
  status    String
  reason    String?
  createdAt DateTime @default(now())
}

model KnowledgeBase {
  id        String          @id @default(uuid())
  title     String
  category  String          @default("FAQ")
  content   String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id              String        @id @default(uuid())
  knowledgeBaseId String
  chunkIndex      Int
  chunkContent    String
  vectorEmbedding Json?
  createdAt       DateTime      @default(now())
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
}

model DynamicIntakeQuestion {
  id             String   @id @default(uuid())
  stepOrder      Int      @unique
  fieldKey       String   @unique
  questionPrompt String
  validationType String   @default("TEXT")
  options        Json?
  isMandatory    Boolean  @default(true)
  isSkippable    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IntakeSession {
  id                String   @id @default(uuid())
  phoneNumber       String   @unique
  leadId            String?
  currentFieldKey   String?
  collectedFields   Json     @default("{}")
  status            String   @default("IN_PROGRESS")
  isComplete        Boolean  @default(false)
  interruptionCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
